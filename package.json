{
  "name": "dsh-auto-open-files",
  "version": "0.1.0",
  "private": true,
  "description": "Opens the right sidebar's Files tab automatically for every new session, so the file panel no longer needs a manual click.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
